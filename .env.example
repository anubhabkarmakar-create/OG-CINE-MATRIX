# GEMINI_API_KEY: Optional Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# TMDB_API_KEY: The Movie Database API Key (v3 auth) or Access Token
# Get a free key at https://www.themoviedb.org/settings/api
# The app will use live TMDB data for Movies and Web Series if set;
# otherwise it seamlessly falls back to the rich built-in curated matrix dataset.
VITE_TMDB_API_KEY=""
TMDB_API_KEY=""

# JIKAN_API: Used for Anime data from MyAnimeList.
# Public and free (no API key required): https://api.jikan.moe/v4/

